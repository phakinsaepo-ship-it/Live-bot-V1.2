import requests
import time
import random
import os
from datetime import datetime

# ================== SETTINGS ==================
STARTING_EQUITY = 100
POSITION_SIZE_PCT = 0.5
SLEEP_SECONDS = 7

# Risk / Exit rules
STOP_LOSS_PCT = -0.18           # Hard stop loss -18%
TRAIL_ACTIVATION_PCT = 0.08     # Start trailing after +8%
TRAIL_PCT = 0.12                # Trail 12% from highest price

# Telegram
TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN")
TELEGRAM_CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")

def send_telegram(message):
    if not TELEGRAM_TOKEN or not TELEGRAM_CHAT_ID:
        return
    try:
        url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
        data = {
            "chat_id": TELEGRAM_CHAT_ID,
            "text": message,
            "parse_mode": "HTML"
        }
        requests.post(url, data=data, timeout=10)
    except:
        pass

class State:
    def __init__(self):
        self.equity = STARTING_EQUITY
        self.start_equity = STARTING_EQUITY
        self.wins = 0
        self.losses = 0
        self.open_trade = None
        self.line = 140
        self.cycle = 0

    def log(self, agent, message):
        now = datetime.now().strftime("%H:%M:%S")
        print(f"{now}  {agent:<11} {message}", flush=True)
        self.line += 1

state = State()

class ScannerAgent:
    def run(self):
        state.log("SCANNER", "Scanning new pairs + volume spikes...")
        try:
            r = requests.get("https://api.dexscreener.com/token-boosts/top/v1", timeout=10)
            boosts = r.json()
            addresses = [item["tokenAddress"] for item in boosts if item.get("chainId") == "solana" and item.get("tokenAddress")]
            if not addresses:
                state.log("SCANNER", "No tokens found")
                return []

            addr_str = ",".join(addresses[:8])
            r2 = requests.get(f"https://api.dexscreener.com/tokens/v1/solana/{addr_str}", timeout=10)
            pairs = r2.json()

            tokens = []
            for p in pairs:
                try:
                    base = p.get("baseToken") or {}
                    symbol = base.get("symbol") or "???"
                    token_address = base.get("address")
                    price = float(p.get("priceUsd") or 0)
                    liq = float(p.get("liquidity", {}).get("usd") or 0)
                    vol = float(p.get("volume", {}).get("h24") or 0)

                    price_change = p.get("priceChange", {})
                    change_h1 = float(price_change.get("h1") or 0)
                    change_h24 = float(price_change.get("h24") or 0)

                    if price > 0 and liq > 10000 and token_address:
                        tokens.append({
                            "symbol": "$" + symbol[:10],
                            "token_address": token_address,
                            "price": price,
                            "liquidity": liq,
                            "volume": vol,
                            "change_h1": change_h1,
                            "change_h24": change_h24
                        })
                except:
                    continue

            state.log("SCANNER", f"Found {len(tokens)} tokens")
            return tokens
        except Exception as e:
            state.log("SCANNER", f"Error: {str(e)[:60]}")
            return []

class RugCheckAgent:
    def run(self, token):
        symbol = token["symbol"]
        liquidity = token["liquidity"]
        volume = token["volume"]

        if liquidity < 25000:
            state.log("RUG CHECK", f"FILTERED {symbol} → low liquidity")
            return False
        if volume < 8000:
            state.log("RUG CHECK", f"FILTERED {symbol} → low volume")
            return False
        if volume < liquidity * 0.12:
            state.log("RUG CHECK", f"FILTERED {symbol} → weak volume")
            return False

        state.log("RUG CHECK", f"PASS {symbol}")
        return True

class SizerAgent:
    def run(self):
        size = state.equity * POSITION_SIZE_PCT
        state.log("SIZER", f"{POSITION_SIZE_PCT*100:.0f}% = ${size:,.2f}")
        return size

class ExecutorAgent:
    def enter(self, token, size_usd):
        if state.open_trade:
            return

        state.open_trade = {
            "symbol": token["symbol"],
            "token_address": token["token_address"],
            "entry": token["price"],
            "size": size_usd,
            "highest": token["price"],          # for trailing stop
            "trail_active": False,
            "change_h1": token.get("change_h1", 0),
            "change_h24": token.get("change_h24", 0),
            "entered_at": time.time()
        }

        state.log("EXECUTOR", f"ENTER {token['symbol']} LONG @ ${token['price']:.8f}")
        state.log("LOGGER", f"line #{state.line} enter {token['symbol']}")

        send_telegram(
            f"<b>ENTER</b> {token['symbol']}\n"
            f"Size: ${size_usd:,.2f}\n"
            f"Entry: ${token['price']:.8f}\n"
            f"1h Change: {token.get('change_h1', 0):+.1f}%"
        )

    def get_live_price(self, token_address):
        """Fetch current price from DexScreener"""
        try:
            url = f"https://api.dexscreener.com/tokens/v1/solana/{token_address}"
            r = requests.get(url, timeout=8)
            pairs = r.json()
            if not pairs:
                return None

            # Prefer the pair with highest liquidity
            best = max(pairs, key=lambda p: float(p.get("liquidity", {}).get("usd") or 0))
            price = float(best.get("priceUsd") or 0)
            return price if price > 0 else None
        except Exception as e:
            state.log("EXECUTOR", f"Price fetch error: {str(e)[:50]}")
            return None

    def try_exit(self):
        if not state.open_trade:
            return

        trade = state.open_trade
        symbol = trade["symbol"]
        entry = trade["entry"]
        size = trade["size"]
        token_address = trade["token_address"]

        current_price = self.get_live_price(token_address)

        if current_price is None:
            state.log("EXECUTOR", f"EXIT {symbol} → price data gone (possible rug)")
            pnl = size * -0.15
            self._close_trade(symbol, pnl, "DATA GONE")
            return

        # Update highest price
        if current_price > trade["highest"]:
            trade["highest"] = current_price

        change_from_entry = (current_price - entry) / entry
        change_from_high = (current_price - trade["highest"]) / trade["highest"]
        pnl = size * change_from_entry

        # Activate trailing stop once we are +TRAIL_ACTIVATION_PCT
        if not trade["trail_active"] and change_from_entry >= TRAIL_ACTIVATION_PCT:
            trade["trail_active"] = True
            state.log("TRAIL", f"{symbol} trailing stop ACTIVATED at +{change_from_entry*100:.1f}%")

        # Live monitoring log
        trail_status = "ACTIVE" if trade["trail_active"] else "waiting"
        state.log(
            "MONITOR",
            f"{symbol}  ${current_price:.8f}  "
            f"from entry {change_from_entry*100:+.1f}%  "
            f"from high {change_from_high*100:+.1f}%  "
            f"trail:{trail_status}  PnL ${pnl:+.2f}"
        )

        # === Exit rules ===
        reason = None

        # 1. Hard Stop Loss
        if change_from_entry <= STOP_LOSS_PCT:
            reason = f"STOP LOSS {change_from_entry*100:.1f}%"

        # 2. Trailing Stop (only after activation)
        elif trade["trail_active"] and change_from_high <= -TRAIL_PCT:
            reason = f"TRAILING STOP  high→{change_from_high*100:.1f}%  (peak was ${trade['highest']:.8f})"

        if reason:
            self._close_trade(symbol, pnl, reason)

    def _close_trade(self, symbol, pnl, reason):
        state.equity += pnl

        if pnl >= 0:
            state.wins += 1
            result = f"+${pnl:,.2f}"
        else:
            state.losses += 1
            result = f"-${abs(pnl):,.2f}"

        state.log("EXECUTOR", f"EXIT {symbol} {result}  ({reason})")
        state.log("EQUITY", f"Balance → ${state.equity:,.2f}")

        send_telegram(
            f"<b>EXIT</b> {symbol}\n"
            f"Result: {result}\n"
            f"Reason: {reason}\n"
            f"Balance: ${state.equity:,.2f}"
        )

        state.open_trade = None

class LoggerAgent:
    def heartbeat(self):
        state.log("LOGGER", f"line #{state.line} system alive")

class EquityAgent:
    def report(self):
        total = state.wins + state.losses
        wr = (state.wins / total * 100) if total > 0 else 0
        state.log("EQUITY", f"${state.equity:,.2f} | {state.wins}W {state.losses}L ({wr:.0f}%)")

# ================== MAIN ==================
scanner = ScannerAgent()
rug = RugCheckAgent()
sizer = SizerAgent()
executor = ExecutorAgent()
logger = LoggerAgent()
equity = EquityAgent()

print("=" * 60, flush=True)
print("  GROK BOT TERMINAL - TRAILING STOP", flush=True)
print(f"  Starting Balance: ${state.equity:,.2f}", flush=True)
print(f"  Hard SL: {STOP_LOSS_PCT*100:.0f}%", flush=True)
print(f"  Trail activates at +{TRAIL_ACTIVATION_PCT*100:.0f}%  |  Trail distance: {TRAIL_PCT*100:.0f}%", flush=True)
print("=" * 60, flush=True)

state.log("SYSTEM", "Paper trading + live price + trailing stop")
send_telegram(
    "<b>Grok Bot Updated</b>\n"
    "Trailing Stop enabled\n"
    f"Activates at +{TRAIL_ACTIVATION_PCT*100:.0f}%\n"
    f"Trails {TRAIL_PCT*100:.0f}% from high\n"
    f"Hard SL {STOP_LOSS_PCT*100:.0f}%\n"
    "Still Paper Trading only"
)

while True:
    state.cycle += 1
    print(f"\n------ Cycle {state.cycle} ------", flush=True)

    tokens = scanner.run()

    if not state.open_trade:
        for token in tokens[:2]:
            if rug.run(token):
                size = sizer.run()
                executor.enter(token, size)
                break

    executor.try_exit()

    logger.heartbeat()
    equity.report()
    time.sleep(SLEEP_SECONDS)
